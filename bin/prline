#!/usr/bin/env bash
# prline: one-line GitHub PR + CI summary for the current branch, for status lines.
#
#   prline [dir]          print cached line for dir's repo/branch; refresh in background if stale
#   prline --refresh [dir] fetch synchronously and print
#   prline --format-pr    render `gh pr view --json` JSON from stdin (tests; needs jq)
#   prline --format-run   render `gh run list --json` JSON from stdin (tests; needs jq)
#   prline --mine          print cached line of my open PRs across GitHub (authored / review requests / involved)
#   prline --mine --refresh fetch synchronously and print
#   prline --format-mine   render the --mine GraphQL JSON from stdin (tests; needs jq)
#
# Requires: bash, git, gh (authenticated). Nothing else at runtime.
#
# Env: PRLINE_TTL (seconds, default 60), PRLINE_MINE_TTL (default 180), PRLINE_MINE_DAYS (default 30),
#      PRLINE_NO_COLOR=1, XDG_CACHE_HOME.
set -uo pipefail

TTL="${PRLINE_TTL:-60}"
MINE_TTL="${PRLINE_MINE_TTL:-180}"   # search API is rate-limited to 30/min; this is one call
MINE_DAYS="${PRLINE_MINE_DAYS:-30}"  # authored/involved PRs untouched longer than this are noise
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/prline"
PR_FIELDS="number,state,isDraft,reviewDecision,mergeable,statusCheckRollup"

# --- rendering (pure: JSON in, one line out) ---------------------------------

JQ_COLORS='
  def c($code; $s): if $ENV.PRLINE_NO_COLOR == "1" then $s else "\u001b[\($code)m\($s)\u001b[0m" end;
  def green($s): c("32"; $s);  def red($s): c("31"; $s);   def yellow($s): c("33"; $s);
  def magenta($s): c("35"; $s); def dim($s): c("2"; $s);
'

JQ_PR="$JQ_COLORS"'
  def bucket:
    if .__typename == "StatusContext" then
      (if .state == "SUCCESS" then "pass" elif (.state == "PENDING" or .state == "EXPECTED") then "pending" else "fail" end)
    elif .status != "COMPLETED" then "pending"
    elif (.conclusion == "SUCCESS") then "pass"
    elif (.conclusion == "SKIPPED" or .conclusion == "NEUTRAL") then "skip"
    else "fail" end;

  def checks:
    [ (.statusCheckRollup // [])[] | {name: (.name // .context), b: bucket} ] as $all
    | [ $all[] | select(.b != "skip") ] as $c
    | ([ $c[] | select(.b == "fail") ] | map(.name) | unique) as $fail
    | ([ $c[] | select(.b == "pending") ] | length) as $pend
    | ([ $c[] | select(.b == "pass") ] | length) as $pass
    | if ($c | length) == 0 then empty
      elif ($fail | length) > 0 then
        red("CI ✗ \($fail | length) failing") + dim(" (" + ($fail[:3] | map(if length > 24 then .[:23] + "…" else . end) | join(", ")) + (if ($fail | length) > 3 then ", …" else "" end) + ")")
      elif $pend > 0 then yellow("CI ● \($pend) running") + dim(" \($pass)/\($c | length)")
      else green("CI ✓ \($pass)") end;

  def review:
    if .reviewDecision == "APPROVED" then green("✓ approved")
    elif .reviewDecision == "CHANGES_REQUESTED" then red("changes requested")
    elif .reviewDecision == "REVIEW_REQUIRED" then yellow("review required")
    else empty end;

  def head:
    "PR #\(.number) " +
    if .state == "MERGED" then magenta("merged")
    elif .state == "CLOSED" then red("closed")
    elif .isDraft then dim("draft")
    else green("open") end;

  if .state == "OPEN" then
    [ head, review, (if .mergeable == "CONFLICTING" then red("⚠ conflicts") else empty end), checks ]
  else [ head ] end
  | join(dim(" · "))
'

JQ_RUN="$JQ_COLORS"'
  (.[0] // empty) as $r
  | dim("no PR · ") + $r.workflowName + " " +
    if $r.status != "completed" then yellow("●")
    elif $r.conclusion == "success" then green("✓")
    elif ($r.conclusion == "skipped" or $r.conclusion == "neutral") then dim("–")
    else red("✗") end
'

# Input: the GraphQL answer of MINE_QUERY (with or without the .data wrapper).
JQ_MINE="$JQ_COLORS"'
  (.data // .) as $d
  | ($d.authored.nodes // []) as $a
  | ([ $a[] | select(.reviewDecision == "APPROVED") ] | length) as $ok
  | ([ $a[] | select(.reviewDecision == "CHANGES_REQUESTED") ] | length) as $bad
  | (($a | length) - $ok - $bad) as $wait
  | ($d.reviewDirect.issueCount // 0) as $direct
  | (($d.reviewAll.issueCount // 0) - $direct | if . < 0 then 0 else . end) as $team
  | ($d.assigned.issueCount // 0) as $assigned
  | ($d.involves.issueCount // 0) as $inv
  | def n($v; $f): if $v > 0 then $f else dim($v | tostring) end;
    "PRs "
    + ([ "✎ " + n($a | length; ($a | length | tostring))
           + (if ($a | length) > 0 then " (" + ([ (if $ok > 0 then green("✓\($ok)") else empty end),
                                                 (if $bad > 0 then red("✗\($bad)") else empty end),
                                                 (if $wait > 0 then yellow("●\($wait)") else empty end) ] | join(" ")) + ")"
              else "" end),
         (if $assigned > 0 then "📌 " + yellow($assigned | tostring) else empty end),
         "👀 " + n($direct; yellow($direct | tostring)) + (if $team > 0 then dim(" +\($team) team") else "" end),
         "💬 " + n($inv; ($inv | tostring)) ]
       | join(dim(" · ")))
'

# Four buckets, one request. Review requests split into direct and via-team; "involves" excludes the other buckets.
MINE_QUERY='query($authored: String!, $assigned: String!, $involves: String!, $reviewAll: String!, $reviewDirect: String!) {
  authored: search(type: ISSUE, query: $authored, first: 50) { nodes { ... on PullRequest { reviewDecision } } }
  assigned: search(type: ISSUE, query: $assigned, first: 1) { issueCount }
  involves: search(type: ISSUE, query: $involves, first: 1) { issueCount }
  reviewAll: search(type: ISSUE, query: $reviewAll, first: 1) { issueCount }
  reviewDirect: search(type: ISSUE, query: $reviewDirect, first: 1) { issueCount }
}'

# Runtime uses gh's built-in jq (--jq), so jq itself is only needed for the offline test modes.
format_pr()   { jq -r "$JQ_PR"; }
format_run()  { jq -r "$JQ_RUN"; }
format_mine() { jq -r "$JQ_MINE"; }

# --- fetching -----------------------------------------------------------------

# Prints the rendered line (possibly empty). Never fails loudly: status lines must stay quiet.
fetch() {
  local branch="$1" out err rc
  err=$(mktemp) || return 0
  out=$(gh pr view --json "$PR_FIELDS" --jq "$JQ_PR" 2>"$err"); rc=$?
  if [ $rc -eq 0 ]; then
    printf '%s' "$out"
  elif grep -q "no pull requests found" "$err"; then
    gh run list --branch "$branch" --limit 1 --json status,conclusion,workflowName --jq "$JQ_RUN" 2>/dev/null
  elif grep -qiE "remotes|not a git repository|could not determine" "$err"; then
    :   # not a GitHub repo: show nothing
  else
    printf '\033[2mPR ? (gh: %s)\033[0m' "$(head -n1 "$err" | cut -c1-40)"
  fi
  rm -f "$err"
}

fetch_mine() {
  local since out err rc
  since=$(date -v-"${MINE_DAYS}"d +%F 2>/dev/null || date -d "${MINE_DAYS} days ago" +%F 2>/dev/null) || return 0
  err=$(mktemp) || return 0
  out=$(gh api graphql -f query="$MINE_QUERY" \
    -f authored="is:pr is:open author:@me -is:draft updated:>$since" \
    -f assigned="is:pr is:open assignee:@me -author:@me" \
    -f involves="is:pr is:open involves:@me -author:@me -assignee:@me -review-requested:@me updated:>$since" \
    -f reviewAll="is:pr is:open review-requested:@me" \
    -f reviewDirect="is:pr is:open user-review-requested:@me" \
    --jq "$JQ_MINE" 2>"$err"); rc=$?
  if [ $rc -eq 0 ]; then
    printf '%s' "$out"
  else
    printf '\033[2mPRs ? (gh: %s)\033[0m' "$(head -n1 "$err" | cut -c1-40)"
  fi
  rm -f "$err"
}

mtime() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo 0; }

refresh() {   # refresh <cachefile> <fetch command...>
  local cache="$1" lock="$1.lock" tmp; shift
  # Atomic lock; break locks older than 2 minutes (crashed refresh).
  if ! mkdir "$lock" 2>/dev/null; then
    [ $(( $(date +%s) - $(mtime "$lock") )) -gt 120 ] && rm -rf "$lock" && mkdir "$lock" 2>/dev/null || return 0
  fi
  tmp="$cache.$$"
  "$@" >"$tmp" && mv -f "$tmp" "$cache"
  rm -rf "$lock" "$tmp"
}

# Prints the cached line, refreshing in the background when stale (or synchronously with sync=1).
serve() {   # serve <cachefile> <ttl> <sync> <fetch command...>
  local cache="$1" ttl="$2" sync="$3"; shift 3
  mkdir -p "$CACHE_DIR"
  if [ "$sync" -eq 1 ]; then
    refresh "$cache" "$@"
  elif [ ! -f "$cache" ] || [ $(( $(date +%s) - $(mtime "$cache") )) -ge "$ttl" ]; then
    # Stale-while-revalidate: never block the status line on the network.
    ( refresh "$cache" "$@" ) </dev/null >/dev/null 2>&1 &
    disown 2>/dev/null || true
  fi
  [ -f "$cache" ] && cat "$cache"
  return 0
}

main() {
  local sync=0 mine=0
  while :; do
    case "${1:-}" in
      --format-pr)   format_pr;   return ;;
      --format-run)  format_run;  return ;;
      --format-mine) format_mine; return ;;
      --refresh)     sync=1; shift ;;
      --mine)        mine=1; shift ;;
      -h|--help)     sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; return ;;
      *) break ;;
    esac
  done
  command -v gh >/dev/null || return 0

  if [ $mine -eq 1 ]; then
    serve "$CACHE_DIR/mine" "$MINE_TTL" "$sync" fetch_mine
    return 0
  fi

  cd "${1:-.}" 2>/dev/null || return 0
  local root branch key
  root=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
  branch=$(git branch --show-current 2>/dev/null)
  [ -n "$branch" ] || return 0   # detached HEAD

  key=$(printf '%s|%s' "$root" "$branch" | cksum | tr ' ' '-')
  serve "$CACHE_DIR/$key" "$TTL" "$sync" fetch "$branch"
}

main "$@"
